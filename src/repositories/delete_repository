from sqlalchemy.orm import Session
from src.models.product import Product


class ProductRepository:
    def get_by_id(
        self,
        db: Session,
        product_id: int,
    ) -> Product | None:
        return (
            db.query(Product)
            .filter(Product.id == product_id)
            .first()
        )

    def delete_product(
        self,
        db: Session,
        product_id: int,
    ) -> Product | None:
        product = self.get_by_id(db, product_id)

        if product is None:
            return None

        db.delete(product)
        db.commit()

        return product